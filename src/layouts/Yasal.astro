---
/* Yasal sayfa kabuğu.

   Metinler değişmedi, yalnızca sunumları yeni tasarıma taşındı.
   Tek zemin (kağıt), tek sütun, uzun okuma için genişletilmiş satır
   aralığı. Bu sayfalarda zemin geçişi yok; okurken renk değişmesi
   dikkat dağıtır ve burada anlatılacak bir hikaye yok.

   Yalnızca Türkçe yayınlanıyor. Dil değiştirici basılmıyor, çünkü
   gidilecek bir İngilizce karşılığı yok. */

import Temel from './Temel.astro'
import { icerikAl } from '../icerik'
import type { YasalMetin } from '../data/legal/tip'

interface Props {
  metin: YasalMetin
  /** Dil önekinden arınmış sayfa yolu. Kanonik adres için gerekli. */
  sayfa: string
}

const { metin, sayfa } = Astro.props
const dil = 'tr' as const
const icerik = icerikAl(dil)
---

<Temel
  dil={dil}
  icerik={icerik}
  baslik={`${metin.baslik} · Monti Labs`}
  aciklama={metin.ozet}
  sayfa={sayfa}
  tekDil
>
  <article class="bolum yasal" data-tema="kagit">
    <div class="kabuk ic">
      <h1 class="bolum-basligi">{metin.baslik}</h1>
      <p class="metin ozet">{metin.ozet}</p>
      <p class="etiket ikincil tarih">Son güncelleme: {metin.guncellenmeTarihi}</p>

      {
        metin.bolumler.map((bolum) => (
          <section class="parca">
            <h2 class="alt-baslik">{bolum.baslik}</h2>
            {bolum.paragraflar.map((p) => (
              <p class="metin">{p}</p>
            ))}
          </section>
        ))
      }
    </div>
  </article>
</Temel>

<style>
  .yasal {
    color: var(--metin);
    padding-block: calc(var(--b8) + var(--b5)) var(--b8);
  }

  .ic {
    max-width: 62rem;
  }

  .ozet {
    margin-top: var(--b4);
    max-width: 62ch;
  }

  .tarih {
    margin-top: var(--b4);
    padding-bottom: var(--b6);
    border-bottom: 1px solid var(--cizgi);
  }

  .parca {
    margin-top: var(--b6);
    max-width: 68ch;
  }

  .alt-baslik {
    font-variation-settings: 'wdth' 106;
    font-weight: 600;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin-bottom: var(--b3);
  }

  .parca .metin + .metin {
    margin-top: var(--b3);
  }
</style>

---
/* Sayfa kabuğu.

   Font yüzü burada satır içi üretiliyor, ayrı bir CSS dosyasında değil.
   Nedeni taban yolu: site /monti-labs altında duruyor ve düz CSS içinde
   bu değeri okumanın yolu yok. yol() yardımcısı yalnızca bileşen
   içinde çalışıyor.

   Font iki parçaya bölünmüş. Ana dosya latin harfleri, rakamları ve
   noktalamayı taşıyor. Ek dosya yalnızca Ğ ğ İ Ş ş karakterlerini
   taşıyor, 6.6 KB. unicode-range sayesinde İngilizce sayfa ek dosyayı
   hiç indirmiyor. Üretimi: scripts/font-altkume.sh */

import '../styles/temel.css'

import ZeminKatmani from '../components/ZeminKatmani.astro'
import Baslik from '../components/Baslik.astro'
import AltBilgi from '../components/AltBilgi.astro'

import { yol, tamAdres, mutlak } from '../lib/yol'
import { diller, dilKodlari, sayfaYolu, varsayilanDil, type Dil } from '../lib/diller'
import { ARAMA_MOTORLARINA_ACIK } from '../data/site'
import type { Icerik } from '../icerik'

interface Props {
  dil: Dil
  icerik: Icerik
  baslik?: string
  aciklama?: string
  /** Dil önekinden arınmış sayfa yolu. hreflang ve dil değiştirici kullanır. */
  sayfa?: string
  /** Yasal sayfalar gibi tek dilli sayfalarda başlık ve alt bilgi sadeleşir. */
  tekDil?: boolean
}

const {
  dil,
  icerik,
  baslik = icerik.meta.baslik,
  aciklama = icerik.meta.aciklama,
  sayfa = '/',
  tekDil = false,
} = Astro.props

const anaFont = yol('/fontlar/archivo-tr-en.woff2')
const ekFont = yol('/fontlar/archivo-tr-ek.woff2')

/* Alt küme betiğinde tanımlanan aralıkların birebir karşılığı.
   scripts/font-altkume.sh değişirse burası da değişmeli. */
const anaAralik =
  'U+0020-007E,U+00A0,U+00A9,U+00AB,U+00AE,U+00B7,U+00BB,U+00C7,U+00D6,U+00DC,U+00E7,U+00F6,U+00FC,U+0131,U+2010-2015,U+2018-201A,U+201C-201E,U+2022,U+2026,U+2039,U+203A,U+20AC'
const ekAralik = 'U+011E,U+011F,U+0130,U+015E,U+015F'

const fontYuzu = `
@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 100 900;
  font-stretch: 62% 125%;
  font-display: swap;
  src: url('${anaFont}') format('woff2-variations');
  unicode-range: ${anaAralik};
}
@font-face {
  font-family: 'Archivo';
  font-style: normal;
  font-weight: 100 900;
  font-stretch: 62% 125%;
  font-display: swap;
  src: url('${ekFont}') format('woff2-variations');
  unicode-range: ${ekAralik};
}
`.trim()

const kanonik = mutlak(sayfaYolu(sayfa, dil), Astro.site)
const ogGorsel = tamAdres('/og.png', Astro.site)
const yil = new Date().getFullYear()
---

<!doctype html>
<html lang={dilKodlari[dil]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Kaydırma sırasında açılan parçalar yalnızca JavaScript açıkken
         gizli başlıyor. Bu satır head'in en başında duruyor ki içerik
         boyanmadan önce sınıf yerine otursun ve titreme olmasın. -->
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>

    <title>{baslik}</title>
    <meta name="description" content={aciklama} />

    {
      ARAMA_MOTORLARINA_ACIK ? null : (
        <meta name="robots" content="noindex, nofollow" />
      )
    }

    <link rel="canonical" href={kanonik} />

    {
      !tekDil &&
        diller.map((kod) => (
          <link
            rel="alternate"
            hreflang={dilKodlari[kod]}
            href={mutlak(sayfaYolu(sayfa, kod), Astro.site)}
          />
        ))
    }
    {
      !tekDil && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={mutlak(sayfaYolu(sayfa, varsayilanDil), Astro.site)}
        />
      )
    }

    <link rel="preload" href={anaFont} as="font" type="font/woff2" crossorigin />
    {
      dil === 'tr' && (
        <link rel="preload" href={ekFont} as="font" type="font/woff2" crossorigin />
      )
    }

    <style is:inline set:html={fontYuzu}></style>

    <link rel="icon" href={yol('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={yol('/apple-touch-icon.png')} />
    <link rel="manifest" href={yol('/site.webmanifest')} />
    <meta name="theme-color" content="#1F2FA0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Monti Labs" />
    <meta property="og:locale" content={dil === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:title" content={icerik.meta.ogBaslik} />
    <meta property="og:description" content={icerik.meta.ogAciklama} />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={ogGorsel} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href={yol('/sitemap-index.xml')} />
  </head>

  <body>
    <ZeminKatmani />
    <Baslik dil={dil} icerik={icerik} sayfa={sayfa} tekDil={tekDil} />

    <main id="icerik">
      <slot />
    </main>

    <AltBilgi dil={dil} icerik={icerik} yil={yil} />
  </body>
</html>

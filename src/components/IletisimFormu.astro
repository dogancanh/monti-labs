---
/* İletişim formu.

   Dört alan. Enterprise satın alma formu gibi görünmüyor.
   Kutu yerine alt çizgi: sayfanın editoryal diline uyuyor.

   GitHub Pages statik sunum yaptığı için doğrulama istemcide yapılır,
   gönderim üçüncü taraf servise gider. Sunucu tarafı uç nokta
   sunucu/iletisim-uc-noktasi.ts dosyasında duruyor ve site bir Node
   ortamına taşındığında olduğu gibi kullanılabilir. */

import { icerik } from '../data/icerik'
import { sirket, FORM_SERVISI, DISCORD_BILDIRIM } from '../data/site'
import { yol } from '../lib/yol'

const i = icerik.iletisim
const epostaBelli = !sirket.eposta.startsWith('DEGISTIR')
const formHazir = FORM_SERVISI.anahtar.length > 0

const altMetin = i.formAltMetin.replace('{sure}', sirket.formDonusSuresi)
const basari = i.basariMesaji.replace('{sure}', sirket.formDonusSuresi)
const hata = i.hataMesaji.replace('{eposta}', epostaBelli ? sirket.eposta : 'bize')
---

{
  !formHazir && (
    <p class="baglanmadi kunye" role="note">
      Form gönderim servisi tanımlı değil. Bağlamak için src/data/site.ts içindeki
      FORM_SERVISI.anahtar alanını doldurun.
    </p>
  )
}

<form
  class="form"
  id="iletisim-formu"
  method="post"
  action={FORM_SERVISI.adres}
  novalidate
  data-hazir={formHazir ? 'evet' : 'hayir'}
  data-adres={FORM_SERVISI.adres}
  data-anahtar={FORM_SERVISI.anahtar}
  data-discord={DISCORD_BILDIRIM.adres}
  data-basari={basari}
  data-hata={hata}
  data-gonderiliyor={i.gonderiliyor}
  data-gonder={i.gonderButonu}
>
  <div class="izgara">
    <div class="alan">
      <label for="adSoyad">{i.alanlar.adSoyad}</label>
      <input type="text" id="adSoyad" name="adSoyad" autocomplete="name" required maxlength="100" />
      <p class="alan-hata" id="hata-adSoyad" hidden></p>
    </div>

    <div class="alan">
      <label for="eposta">{i.alanlar.eposta}</label>
      <input type="email" id="eposta" name="eposta" autocomplete="email" required maxlength="200" />
      <p class="alan-hata" id="hata-eposta" hidden></p>
    </div>

    <div class="alan alan-genis">
      <label for="sirket">
        {i.alanlar.sirket}
        <span class="opsiyonel">{i.opsiyonelEtiketi}</span>
      </label>
      <input type="text" id="sirket" name="sirket" autocomplete="organization" maxlength="120" />
      <p class="alan-hata" id="hata-sirket" hidden></p>
    </div>

    <div class="alan alan-genis">
      <label for="mesaj">{i.alanlar.mesaj}</label>
      <textarea id="mesaj" name="mesaj" rows="4" required minlength="20" maxlength="4000"></textarea>
      <p class="alan-hata" id="hata-mesaj" hidden></p>
    </div>
  </div>

  {/* Bal küpü. İnsan görmez, ekran okuyucu okumaz, klavye uğramaz. */}
  <div class="kupe" aria-hidden="true">
    <label for="botcheck">Web siteniz</label>
    <input type="checkbox" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
  </div>

  <div class="onay">
    <input type="checkbox" id="kvkkOnay" name="kvkkOnay" required />
    <label for="kvkkOnay">
      {i.kvkkOnayOncesi}<a href={yol('/kvkk')}>{i.kvkkOnayBaglantiEtiketi}</a>{i.kvkkOnaySonrasi}
    </label>
  </div>
  <p class="alan-hata onay-hata" id="hata-kvkkOnay" hidden></p>

  <div class="alt">
    <button type="submit" class="dugme-birincil gonder" data-gonder-dugmesi disabled={!formHazir}>
      <span>{i.gonderButonu}</span>
      <span class="ok" aria-hidden="true">→</span>
    </button>
    <p class="not">{altMetin}</p>
  </div>

  <p class="durum" role="status" aria-live="polite" data-durum hidden></p>

  {
    epostaBelli && (
      <p class="alternatif">
        {i.alternatifOnce}
        <a href={`mailto:${sirket.eposta}`}>{sirket.eposta}</a>
      </p>
    )
  }
</form>

<style>
  .form {
    display: grid;
    gap: var(--ml-space-8);
  }

  .baglanmadi {
    margin-block-end: var(--ml-space-6);
    padding-block-end: var(--ml-space-4);
    border-block-end: 1px solid var(--ml-border);
    color: var(--ml-cream-base);
    text-transform: none;
    letter-spacing: 0.02em;
    line-height: var(--ml-leading-relaxed);
  }

  .izgara {
    display: grid;
    gap: var(--ml-space-6);
  }

  .opsiyonel {
    font-family: var(--ml-font-mono);
    font-size: var(--ml-text-xs);
    font-weight: var(--ml-weight-regular);
    letter-spacing: var(--ml-tracking-wide);
    color: var(--ml-cobalt-200);
    margin-inline-start: var(--ml-space-2);
    text-transform: lowercase;
  }

  .form :global(.alan label) {
    color: var(--ml-cream-base);
  }

  .form :global(.alan input),
  .form :global(.alan textarea) {
    color: var(--ml-cream-base);
    border-block-end-color: rgb(255 244 214 / 0.35);
  }

  .form :global(.alan input:hover),
  .form :global(.alan textarea:hover),
  .form :global(.alan input:focus),
  .form :global(.alan textarea:focus) {
    border-block-end-color: var(--ml-cream-base);
  }

  .form :global(.alan input[aria-invalid='true']),
  .form :global(.alan textarea[aria-invalid='true']) {
    border-block-end-color: var(--ml-cream-base);
    border-block-end-width: 2px;
  }

  .form :global(.alan-yardim) {
    color: var(--ml-cobalt-200);
  }

  .kupe {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .onay {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--ml-space-3);
    align-items: start;
  }

  /* WCAG 2.5.8 en az 24x24 istiyor. */
  .onay input {
    inline-size: 24px;
    block-size: 24px;
    margin-block-start: 0.1rem;
    accent-color: var(--ml-cream-base);
  }

  .onay label {
    font-size: var(--ml-text-sm);
    line-height: var(--ml-leading-normal);
    color: rgb(255 244 214 / 0.82);
  }

  .onay label a {
    color: var(--ml-cream-base);
  }

  .onay-hata {
    margin-block-start: calc(var(--ml-space-6) * -1);
  }

  .alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ml-space-4) var(--ml-space-8);
  }

  /* Görünüm .dugme-birincil'den geliyor; burada yalnızca formun
     kendine özgü durumu tanımlı. */
  .gonder[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .not {
    font-size: var(--ml-text-sm);
    color: var(--ml-cobalt-200);
  }

  .durum {
    padding: var(--ml-space-4);
    border: 1px solid rgb(255 244 214 / 0.4);
    font-size: var(--ml-text-sm);
    color: var(--ml-cream-base);
  }

  .durum[data-tur='basari'] {
    border-color: var(--ml-cream-base);
    font-weight: var(--ml-weight-medium);
  }

  .alternatif {
    font-size: var(--ml-text-sm);
    color: var(--ml-cobalt-200);
  }

  .alternatif a {
    color: var(--ml-cream-base);
  }

  @media (min-width: 620px) {
    .izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--ml-space-8);
    }

    .alan-genis {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const form = document.getElementById('iletisim-formu') as HTMLFormElement | null

  if (form && form.dataset.hazir === 'evet') {
    const dugme = form.querySelector<HTMLButtonElement>('[data-gonder-dugmesi]')!
    const durum = form.querySelector<HTMLParagraphElement>('[data-durum]')!
    const alanlar = ['adSoyad', 'eposta', 'sirket', 'mesaj', 'kvkkOnay']

    /* Mesaj alanının kalıcı yardım metni var. Hata eklenirken o bağlantı
       korunmalı, hata temizlenirken geri gelmeli. */
    const temelAciklama = new Map<string, string>()
    for (const ad of alanlar) {
      const girdi = form.elements.namedItem(ad)
      if (girdi instanceof HTMLElement) {
        temelAciklama.set(ad, girdi.getAttribute('aria-describedby') ?? '')
      }
    }

    const aciklamayiYaz = (girdi: HTMLElement, ad: string, hataVar: boolean): void => {
      const temel = temelAciklama.get(ad) ?? ''
      const deger = [temel, hataVar ? `hata-${ad}` : ''].filter(Boolean).join(' ')
      if (deger) girdi.setAttribute('aria-describedby', deger)
      else girdi.removeAttribute('aria-describedby')
    }

    const hatalariTemizle = (): void => {
      for (const ad of alanlar) {
        const kutu = document.getElementById(`hata-${ad}`)
        if (kutu) {
          kutu.textContent = ''
          kutu.hidden = true
        }
        const girdi = form.elements.namedItem(ad)
        if (girdi instanceof HTMLElement) {
          girdi.removeAttribute('aria-invalid')
          aciklamayiYaz(girdi, ad, false)
        }
      }
      durum.hidden = true
      durum.textContent = ''
      durum.removeAttribute('data-tur')
    }

    const hatalariGoster = (hatalar: Record<string, string>): void => {
      let ilkOdak: HTMLElement | null = null
      for (const [ad, mesaj] of Object.entries(hatalar)) {
        if (ad === 'genel') {
          durum.textContent = mesaj
          durum.hidden = false
          continue
        }
        const kutu = document.getElementById(`hata-${ad}`)
        if (kutu) {
          kutu.textContent = mesaj
          kutu.hidden = false
        }
        const girdi = form.elements.namedItem(ad)
        if (girdi instanceof HTMLElement) {
          girdi.setAttribute('aria-invalid', 'true')
          aciklamayiYaz(girdi, ad, true)
          if (!ilkOdak) ilkOdak = girdi
        }
      }
      if (ilkOdak) ilkOdak.focus()
    }

    /* Statik barındırmada bu kontroller güvenlik sınırı değildir;
       istenmeyen gönderimi asıl eleyen servisin kendi filtresidir.
       Buradaki iş kullanıcıya anında ve anlaşılır geri bildirim vermek. */
    const dogrula = (v: Record<string, string>, onay: boolean) => {
      const h: Record<string, string> = {}

      if (!v.adSoyad) h.adSoyad = 'Ad soyad alanı boş. Size nasıl hitap edeceğimizi yazın.'
      else if (v.adSoyad.length < 2 || v.adSoyad.length > 100)
        h.adSoyad = 'Ad soyad 2 ile 100 karakter arasında olmalı.'

      if (!v.eposta) h.eposta = 'E-posta alanı boş. Dönüş yapabilmemiz için gerekli.'
      else if (v.eposta.length > 200)
        h.eposta = 'E-posta adresi çok uzun. En fazla 200 karakter olabilir.'
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.eposta))
        h.eposta = 'E-posta adresi geçerli görünmüyor. Adresi kontrol edip tekrar deneyin.'

      if (v.sirket.length > 120) h.sirket = 'Şirket adı en fazla 120 karakter olabilir.'

      if (!v.mesaj) h.mesaj = 'Bu alan boş. Şu an işin nasıl yürüdüğünü kısaca yazın.'
      else if (v.mesaj.length < 20) h.mesaj = 'Biraz daha yazın. En az 20 karakter gerekiyor.'
      else if (v.mesaj.length > 4000)
        h.mesaj = 'Çok uzun. En fazla 4000 karakter yazabilirsiniz.'

      if (!onay) h.kvkkOnay = 'Devam etmek için aydınlatma metnini onaylamanız gerekiyor.'

      return h
    }

    form.addEventListener('submit', async (olay) => {
      olay.preventDefault()
      if (dugme.disabled) return
      hatalariTemizle()

      const veri = new FormData(form)
      const al = (ad: string) => String(veri.get(ad) ?? '').trim()
      const degerler = {
        adSoyad: al('adSoyad'),
        eposta: al('eposta'),
        sirket: al('sirket'),
        mesaj: al('mesaj'),
      }
      const onay = veri.get('kvkkOnay') === 'on'

      const hatalar = dogrula(degerler, onay)
      if (Object.keys(hatalar).length > 0) {
        hatalariGoster(hatalar)
        return
      }

      dugme.disabled = true
      const etiket = dugme.querySelector('span')
      if (etiket) etiket.textContent = form.dataset.gonderiliyor ?? 'Gönderiliyor'

      try {
        const yanit = await fetch(form.dataset.adres!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: form.dataset.anahtar,
            subject: `Yeni iletişim formu: ${degerler.adSoyad}`,
            from_name: 'Monti Labs sitesi',
            name: degerler.adSoyad,
            email: degerler.eposta,
            replyto: degerler.eposta,
            sirket: degerler.sirket || '-',
            message: degerler.mesaj,
            botcheck: veri.get('botcheck') ? 'true' : '',
          }),
        })
        const sonuc = (await yanit.json()) as { success?: boolean }

        if (yanit.ok && sonuc.success) {
          // Discord bildirimi. E-posta zaten gitti; buradaki hata
          // kullanıcıya yansıtılmaz.
          const discord = form.dataset.discord
          if (discord) {
            const satir = (etiket: string, deger: string) =>
              deger ? `**${etiket}:** ${deger}\n` : ''
            fetch(discord, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                username: 'Site formu',
                embeds: [
                  {
                    title: 'Yeni iletişim formu',
                    color: 0x263baa,
                    description:
                      satir('Ad soyad', degerler.adSoyad) +
                      satir('E-posta', degerler.eposta) +
                      satir('Şirket', degerler.sirket) +
                      '\n' +
                      degerler.mesaj.slice(0, 1500),
                    timestamp: new Date().toISOString(),
                  },
                ],
                allowed_mentions: { parse: [] },
              }),
            }).catch(() => {})
          }

          form.reset()
          durum.textContent = form.dataset.basari ?? ''
          durum.dataset.tur = 'basari'
          durum.hidden = false
        } else {
          hatalariGoster({ genel: form.dataset.hata ?? '' })
        }
      } catch {
        hatalariGoster({ genel: form.dataset.hata ?? '' })
      } finally {
        dugme.disabled = false
        const e = dugme.querySelector('span')
        if (e) e.textContent = form.dataset.gonder ?? 'Gönder'
      }
    })
  }
</script>

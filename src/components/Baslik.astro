---
/* Sabit başlık.

   Solda işaret ve kelime markası, ortada hap biçimli menü, sağda dil
   değiştirici. Menünün son öğesi (İletişim) dolu düğme.

   Başlık en üstteyken saydam. Sayfa kaydıkça arkasına zeminin
   yarı saydam bir kopyası ve bulanıklık geliyor; yoksa kağıt renkli
   iş kartının üstünden geçerken yazı kaybolur. Renk kaynağı
   --aktif-zemin ve --aktif-metin; ZeminKatmani içindeki gözlemci
   yazıyor. Yasal sayfalarda bu sayede kağıt renginde durur.

   Logo çözümü: başlıkta yalnızca işaret kullanılıyor, kelime markası
   sitenin kendi tipografisiyle diziliyor. Tam logo kilidi alt bilgide.

   JavaScript kapalıyken başlık sabit olmaktan çıkıyor. */

import Isaret from './Isaret.astro'
import DilDegistirici from './DilDegistirici.astro'
import { sayfaYolu, type Dil } from '../lib/diller'
import type { Icerik } from '../icerik'

interface Props {
  dil: Dil
  icerik: Icerik
  sayfa?: string
  /**
   * Sayfanın diğer dilde karşılığı yoksa true.
   * Yasal metinler yalnızca Türkçe yayınlanıyor; oralarda dil
   * değiştirici basılmıyor, çünkü basılsa gidilecek adres 404 verir.
   */
  tekDil?: boolean
}

const { dil, icerik, sayfa = '/', tekDil = false } = Astro.props
const { gezinti } = icerik
---

<header class="baslik">
  <a class="atla" href="#icerik">{gezinti.icerigeAtla}</a>

  <div class="kabuk sira">
    <a class="marka" href={sayfaYolu('/', dil)}>
      <Isaret yukseklik="1em" />
      <span class="ad">Monti Labs</span>
    </a>

    <nav class="genis" aria-label={gezinti.anaMenu}>
      <ul class="hap">
        {
          gezinti.baglantilar.map((b) => (
            <li>
              <a class="oge" href={sayfaYolu(b.hedef, dil)}>
                {b.etiket}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="sag">
      {!tekDil && <DilDegistirici dil={dil} icerik={icerik} sayfa={sayfa} class="genis" />}

      <button class="dar acma" type="button" aria-expanded="false" aria-controls="menu">
        <span class="ac">{gezinti.menuAc}</span>
        <span class="kapa">{gezinti.menuKapat}</span>
      </button>
    </div>
  </div>

  <div class="panel" id="menu" hidden>
    <nav class="kabuk panel-ic" aria-label={gezinti.anaMenu}>
      <ul class="panel-baglantilar">
        {
          gezinti.baglantilar.map((b) => (
            <li>
              <a href={sayfaYolu(b.hedef, dil)}>{b.etiket}</a>
            </li>
          ))
        }
      </ul>
      {!tekDil && <DilDegistirici dil={dil} icerik={icerik} sayfa={sayfa} />}
    </nav>
  </div>
</header>

<style>
  .baslik {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 20;

    /* Başlığın kendi bölümü olmadığı için tema değişkenlerini etkin
       bölümden devralıyor. */
    --zemin: var(--aktif-zemin);
    --metin: var(--aktif-metin);
    --ikincil: var(--aktif-ikincil);
    color: var(--metin);

    padding-block: var(--b4);
    transition:
      color var(--temel) var(--egri),
      background-color var(--temel) var(--egri),
      padding var(--hizli) var(--egri),
      border-color var(--temel) var(--egri);
    border-bottom: 1px solid transparent;
  }

  /* Kaydırınca cam zemin. */
  .baslik.kaydi {
    padding-block: var(--b3);
    background-color: color-mix(in srgb, var(--zemin) 78%, transparent);
    border-bottom-color: var(--cizgi);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  html:not(.js) .baslik {
    position: static;
  }

  .sira {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--b4);
  }

  .marka {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  .ad {
    line-height: 1;
  }

  /* Hap menü */
  .hap {
    display: flex;
    gap: 0.375rem;
    padding: 0.375rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--metin) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--metin) 12%, transparent);
    margin: 0;
  }

  .oge {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--metin);
    transition:
      background-color var(--hizli) var(--egri),
      color var(--hizli) var(--egri);
  }

  .oge:hover {
    background-color: color-mix(in srgb, var(--metin) 10%, transparent);
  }

  .hap li:last-child .oge {
    background-color: var(--metin);
    color: var(--zemin);
  }

  .hap li:last-child .oge:hover {
    opacity: 0.88;
  }

  .sag {
    display: flex;
    align-items: center;
    gap: var(--b4);
  }

  .acma {
    font-size: 0.875rem;
    color: inherit;
  }

  .acma .kapa {
    display: none;
  }

  .acma[aria-expanded='true'] .ac {
    display: none;
  }

  .acma[aria-expanded='true'] .kapa {
    display: inline;
  }

  /* Mobil panel */
  .panel {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: var(--zemin);
    display: flex;
    align-items: center;
  }

  .panel[hidden] {
    display: none;
  }

  .panel-ic {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--b6);
  }

  .panel-baglantilar {
    display: flex;
    flex-direction: column;
    gap: var(--b3);
    margin: 0;
  }

  .panel-baglantilar a {
    font-variation-settings: 'wdth' 110;
    font-weight: 600;
    font-size: clamp(2.25rem, 9vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  /* Geniş ekranda menü düğmesi, dar ekranda hap menü gizli. */
  .dar {
    display: none;
  }

  @media (max-width: 48rem) {
    .genis,
    .sag :global(.genis) {
      display: none;
    }

    .dar {
      display: inline-block;
    }
  }

  /* JavaScript kapalıyken menü düğmesi hiçbir işe yaramaz, gizlenir ve
     bağlantılar her genişlikte görünür kalır. */
  html:not(.js) .dar {
    display: none;
  }

  html:not(.js) .genis {
    display: flex;
    flex-wrap: wrap;
    gap: var(--b3);
  }

  html:not(.js) .hap {
    flex-wrap: wrap;
  }
</style>

<script>
  /* Kaydırınca cam zemin. Eşik 16 piksel; ilk kaydırmada hemen gelir. */
  const baslik = document.querySelector<HTMLElement>('.baslik')

  if (baslik) {
    const guncelle = () => baslik.classList.toggle('kaydi', window.scrollY > 16)
    window.addEventListener('scroll', guncelle, { passive: true })
    guncelle()
  }

  /* Mobil panel. Açıkken sayfa kaydırması kilitleniyor, Escape kapatıyor,
     odak panelin içinde kalıyor. */

  const dugme = document.querySelector<HTMLButtonElement>('.acma')
  const panel = document.querySelector<HTMLElement>('.panel')

  if (dugme && panel) {
    const durumYaz = (acik: boolean) => {
      dugme.setAttribute('aria-expanded', String(acik))
      panel.hidden = !acik
      document.body.style.overflow = acik ? 'hidden' : ''
    }

    dugme.addEventListener('click', () => {
      durumYaz(dugme.getAttribute('aria-expanded') !== 'true')
    })

    /* Panel içindeki bir bağlantıya basınca panel kapansın, yoksa
       hedef bölüm panelin arkasında kalır. */
    panel.addEventListener('click', (olay) => {
      if ((olay.target as HTMLElement).closest('a')) durumYaz(false)
    })

    document.addEventListener('keydown', (olay) => {
      if (olay.key === 'Escape' && !panel.hidden) {
        durumYaz(false)
        dugme.focus()
      }
    })

    /* Ekran genişlerken panel açık kaldıysa kapat, yoksa geniş ekranda
       görünmez bir katman sayfayı kilitli tutar. */
    const genisEkran = window.matchMedia('(min-width: 48.0625rem)')
    genisEkran.addEventListener('change', (olay) => {
      if (olay.matches && !panel.hidden) durumYaz(false)
    })
  }
</script>

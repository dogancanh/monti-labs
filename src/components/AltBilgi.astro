---
/* Alt bilgi.

   Tek satır: solda yatay logo, ortada bağlantılar, sağda telif.
   Şirket künyesi alanları site.ts içinde "DEGISTIR" ile başlıyorsa
   hiç basılmıyor; dolunca ikinci bir ince satır olarak geliyor.

   Logo burada resim olarak duruyor. Başlıkta yalnızca işaret var ve
   kelime markası sitenin fontuyla diziliyor; markanın asıl kilidi
   alt bilgide görünüyor. */

import { sirket } from '../data/site'
import { yol } from '../lib/yol'
import { sayfaYolu, type Dil } from '../lib/diller'
import type { Icerik } from '../icerik'

interface Props {
  dil: Dil
  icerik: Icerik
  yil: number
}

const { dil, icerik, yil } = Astro.props
const { altBilgi } = icerik

/** Doldurulmamış alanlar arayüzde yer kaplamıyor. */
const dolu = (deger: string) => deger.trim().length > 0 && !deger.startsWith('DEGISTIR')

const kunyeSatirlari = [sirket.resmiUnvan, sirket.adres, sirket.vergiDairesiNo, sirket.mersisNo].filter(dolu)
const dipVar = kunyeSatirlari.length > 0 || Boolean(altBilgi.yasalDilNotu)
---

<footer class="alt" data-tema="murekkep">
  <div class="kabuk sira">
    <a class="logo" href={sayfaYolu('/', dil)} aria-label="Monti Labs">
      <img src={yol('/logo-yatay-krem.png')} alt="" width="360" height="53" loading="lazy" decoding="async" />
    </a>

    <nav aria-label={altBilgi.gezintiKunye}>
      <ul class="baglantilar">
        {
          altBilgi.baglantilar.map((b) => (
            <li>
              <a class="bag" href={sayfaYolu(b.hedef, dil)}>
                {b.etiket}
              </a>
            </li>
          ))
        }
        {
          altBilgi.yasal.map((b) => (
            <li>
              <a class="bag" href={yol(b.hedef)} hreflang="tr-TR">
                {b.etiket}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="telif">{altBilgi.telifSablonu.replace('{yil}', String(yil))}</p>
  </div>

  {
    dipVar && (
      <div class="kabuk dip">
        {kunyeSatirlari.length > 0 && (
          <address class="kunye">
            {kunyeSatirlari.map((satir) => (
              <span>{satir}</span>
            ))}
          </address>
        )}
        {altBilgi.yasalDilNotu && <p>{altBilgi.yasalDilNotu}</p>}
      </div>
    )
  }
</footer>

<style>
  .alt {
    color: var(--soluk);
    padding-block: var(--b6) var(--b5);
    font-size: 0.8125rem;
  }

  .sira {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--b4) var(--b5);
  }

  .logo {
    display: block;
  }

  .logo img {
    height: 1.25rem;
    width: auto;
  }

  .baglantilar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--b2) 1.5rem;
    margin: 0;
  }

  .baglantilar .bag {
    color: var(--soluk);
    font-size: 0.8125rem;
  }

  .baglantilar .bag:hover {
    color: var(--metin);
  }

  .dip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--b2) var(--b5);
    margin-top: var(--b4);
    padding-top: var(--b3);
    border-top: 1px solid var(--cizgi);
    font-size: 0.75rem;
  }

  .kunye {
    display: flex;
    flex-wrap: wrap;
    gap: var(--b1) var(--b4);
    font-style: normal;
  }

  @media (max-width: 48rem) {
    .sira {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
/* Çalışmalar. Sitenin merkezi.

   Küçük kart ızgarası yok. Her iş kendi başına geniş bir blok:
   önce ne değiştiği, sonra anlatı, yanında sistem şeması, en altta
   küçük teknoloji künyesi.

   Teknoloji ön planda değil. Ana mesaj sonuç.
   Müşteri adı ve canlı bağlantı paylaşılmıyor. */

import { getCollection } from 'astro:content'
import { icerik } from '../data/icerik'
import Sema from './Sema.astro'

const c = icerik.calismalar

const kayitlar = (await getCollection('calismalar')).sort(
  (a, b) => a.data.sira - b.data.sira,
)

const onaysiz = kayitlar.filter((k) => k.data.onayBekliyor)
if (onaysiz.length > 0) {
  console.warn(
    `\n[monti] ${onaysiz.length} vaka çalışması onay bekliyor ve sitede görünüyor:\n` +
      onaysiz.map((k) => `  - ${k.id} (${k.data.baslik})`).join('\n') +
      `\n  Onayladıktan sonra ilgili dosyada onayBekliyor: false yapın.\n`,
  )
}

const turAdlari: Record<string, string> = {
  uygulama: 'Uygulama',
  'b2b-urun': 'B2B ürün',
  'web-sitesi': 'Web sitesi',
  otomasyon: 'Otomasyon',
  entegrasyon: 'Entegrasyon',
}
---

<section class="calismalar bolum" id="calismalar" aria-labelledby="calismalar-baslik">
  <div class="kabuk">
    <p class="uste kunye">{c.kunye}</p>
    <div class="bas">
      <h2 class="bolum-baslik" id="calismalar-baslik" data-acil>{c.baslik}</h2>
      <p class="bas-alt" data-acil>{c.altMetin}</p>
    </div>
    <p class="gizlilik kunye" data-acil>{c.gizlilikNotu}</p>
  </div>

  <div class="isler">
    {
      kayitlar.map((kayit, i) => {
        const v = kayit.data
        return (
          <article class="is" data-yon={i % 2 === 0 ? 'sag' : 'sol'}>
            <div class="kabuk is-ic">
              <header class="is-bas">
                <p class="kunye is-meta">
                  <span class="is-no">{String(i + 1).padStart(2, '0')}</span>
                  <span class="is-ayrac" aria-hidden="true" />
                  {v.sektor}
                  <span class="is-ayrac" aria-hidden="true" />
                  {turAdlari[v.tur] ?? v.tur}
                </p>
                <p class="is-vurgu" data-acil>
                  {v.vurgu}
                </p>
              </header>

              <div class="is-govde">
                <div class="is-anlati">
                  <div class="alan-blok" data-acil>
                    <h3 class="kunye alan-etiket">{c.alanlar.problem}</h3>
                    <p>{v.problem}</p>
                  </div>
                  <div class="alan-blok" data-acil style="--gecikme:80ms">
                    <h3 class="kunye alan-etiket">{c.alanlar.mudahale}</h3>
                    <p>{v.neYaptik}</p>
                  </div>
                  {v.sonuc && (
                    <div class="alan-blok" data-acil style="--gecikme:160ms">
                      <h3 class="kunye alan-etiket alan-sonuc">{c.alanlar.sonuc}</h3>
                      <p class="sonuc-metin">{v.sonuc}</p>
                    </div>
                  )}
                </div>

                {v.sema && (
                  <div class="is-sema" data-acil style="--gecikme:120ms">
                    <Sema tur={v.sema} aciklama={`${v.baslik} sistem şeması`} />
                  </div>
                )}
              </div>

              {v.teknolojiler.length > 0 && (
                <p class="is-teknoloji kunye">
                  {v.teknolojiler.join('  /  ')}
                </p>
              )}
            </div>
          </article>
        )
      })
    }
  </div>
</section>

<style>
  .calismalar {
    padding-block-end: 0;
  }

  .bas {
    display: grid;
    gap: var(--ml-space-4);
  }

  .bolum-baslik {
    max-width: 14ch;
  }

  .bas-alt {
    font-size: var(--ml-text-xl);
    color: var(--ml-text-muted);
    max-width: 34ch;
  }

  .gizlilik {
    margin-block-start: var(--ml-space-8);
    max-width: 56ch;
    text-transform: none;
    letter-spacing: 0;
    line-height: var(--ml-leading-relaxed);
    color: var(--ml-ink-500);
  }

  /* ---------- İş blokları ---------- */
  .isler {
    margin-block-start: clamp(3rem, 1.5rem + 5vw, 6rem);
  }

  .is {
    padding-block: clamp(3.5rem, 2rem + 5vw, 7rem);
    border-block-start: 1px solid var(--ml-ink-100);
  }

  .is:last-child {
    border-block-end: 1px solid var(--ml-ink-100);
  }

  .is-meta {
    display: flex;
    align-items: center;
    gap: var(--ml-space-3);
    flex-wrap: wrap;
    color: var(--ml-ink-500);
  }

  .is-no {
    color: var(--ml-cobalt-600);
  }

  .is-ayrac {
    width: 12px;
    height: 1px;
    background-color: var(--ml-ink-300);
    flex: none;
  }

  /* Bloğun en üstündeki büyük sonuç cümlesi. Ana mesaj bu. */
  .is-vurgu {
    margin-block-start: var(--ml-space-5, 1.25rem);
    font-family: var(--ml-font-display);
    font-size: var(--ml-text-is);
    font-weight: var(--ml-weight-semibold);
    line-height: var(--ml-leading-tight);
    letter-spacing: var(--ml-tracking-tighter);
    color: var(--ml-ink-900);
    max-width: 20ch;
    text-wrap: balance;
  }

  .is-govde {
    display: grid;
    gap: var(--ml-space-10, 2.5rem);
    margin-block-start: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .is-anlati {
    display: grid;
    gap: var(--ml-space-8);
    align-content: start;
  }

  .alan-blok {
    display: grid;
    gap: var(--ml-space-2);
  }

  .alan-etiket {
    color: var(--ml-ink-500);
  }

  .alan-sonuc {
    color: var(--ml-cobalt-600);
  }

  .alan-blok p {
    font-size: var(--ml-text-base);
    line-height: var(--ml-leading-relaxed);
    color: var(--ml-ink-700);
    max-width: 44ch;
  }

  .sonuc-metin {
    color: var(--ml-ink-900) !important;
    font-weight: var(--ml-weight-medium);
  }

  .is-sema {
    align-self: center;
    padding-block: var(--ml-space-4);
  }

  .is-teknoloji {
    margin-block-start: clamp(2rem, 1rem + 2.5vw, 3rem);
    color: var(--ml-ink-500);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  @media (min-width: 900px) {
    .is-govde {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--ml-space-16);
      align-items: start;
    }

    /* Ritim için şema bir blokta sağda, sonrakinde solda. */
    .is[data-yon='sol'] .is-anlati {
      order: 2;
    }

    .is[data-yon='sol'] .is-sema {
      order: 1;
    }

    .is-vurgu {
      max-width: 24ch;
    }
  }
</style>

---
/* Ne yapıyoruz.

   İkon kartı yok. Dört alan, aralarında saç teli çizgi.
   Numaralandırılmıyor: bunlar bir sıra değil, dört ayrı alan.
   Sıra anlamı taşımadığı yerde numara koymak yalnızca süs olur. */

import { icerik } from '../data/icerik'

const n = icerik.neYapiyoruz
---

<section class="ne bolum" id="ne-yapiyoruz" aria-labelledby="ne-baslik">
  <div class="kabuk ne-ic">
    <div class="ne-bas">
      <p class="kunye uste" data-acil>{n.kunye}</p>
      <h2 class="bolum-baslik" id="ne-baslik" data-acil style="--gecikme:80ms">{n.baslik}</h2>
    </div>

    <ul class="ne-liste" role="list">
      {
        n.kalemler.map((k, i) => (
          <li class="ne-kalem" data-acil style={`--gecikme:${100 + i * 70}ms`}>
            <h3 class="ne-ad">{k.ad}</h3>
            <p class="ne-metin">{k.metin}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ne-liste {
    margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    border-block-start: 1px solid var(--ml-border);
  }

  .ne-kalem {
    display: grid;
    gap: var(--ml-space-2);
    padding-block: clamp(1.75rem, 1rem + 2vw, 2.75rem);
    border-block-end: 1px solid var(--ml-border);
  }

  .ne-ad {
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem);
    line-height: var(--ml-leading-tight);
    letter-spacing: var(--ml-tracking-tight);
  }

  .ne-metin {
    max-width: 48ch;
    color: var(--ml-text-muted);
  }

  @media (min-width: 860px) {
    .ne-ic {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 6rem);
      align-items: start;
    }

    /* Başlık kolonu kaydırma boyunca yerinde kalır: liste okunurken
       hangi bölümde olunduğu görünür durumda kalıyor. */
    .ne-bas {
      position: sticky;
      top: 7rem;
    }

    .ne-liste {
      margin-block-start: 0;
    }

    /* Ad ve açıklama aynı satırda, ortak taban hizasında. */
    .ne-kalem {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
      gap: var(--ml-space-8);
      align-items: baseline;
    }
  }
</style>

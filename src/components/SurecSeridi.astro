---
/* ============================================================
   Süreç şeridi — sayfanın imza öğesi

   Aynı işin iki hali yan yana çizilir. Çubuk genişlikleri
   gerçek dakikalarla orantılıdır, ikisi de aynı ölçeğe göre
   çizilir. İnsanın yaptığı adımlar mürekkep, sistemin yaptığı
   adımlar kobalt renkte.

   Sayılar temsilîdir ve öyle etiketlenmiştir. Marka paketi
   05-web-sitesi-brief.md örnek verinin açıkça örnek olmasını
   ve yuvarlak sayı kullanılmasını şart koşuyor.
   ============================================================ */

import { icerik } from '../data/icerik'

const s = icerik.seritSurec

const toplamlar = s.durumlar.map((d) => d.adimlar.reduce((t, a) => t + a.dakika, 0))
const enBuyuk = Math.max(...toplamlar)

/* Süre tutan adımlar oransal çizilir. Sıfır dakikalık (anlık) adımlar
   süre kaplamadığı için orana katılmaz; her biri sabit genişlikte bir
   işaret olarak çubuğun başına eklenir. İşaret genişliği çubuğun kendi
   uzunluğuna göre değil, sabit piksel olarak verilir; yoksa kısa
   çubuklarda görünmez hale gelirler. */
const ANLIK_PX = 12
const ANLIK_ARA_PX = 2
---

<figure class="serit">
  <figcaption class="serit-ust">
    <span class="kunye serit-kunye">{s.kunye}</span>
    <h2 class="serit-ad">{s.ad}</h2>
  </figcaption>

  <div class="serit-govde">
    {
      s.durumlar.map((durum, i) => {
        const toplam = toplamlar[i]!
        const elleAdimSayisi = durum.adimlar.filter((a) => a.elle).length
        const anlikSayisi = durum.adimlar.filter((a) => a.dakika === 0).length
        const oran = (toplam / enBuyuk) * 100
        const genislik =
          anlikSayisi > 0
            ? `calc(${oran}% + ${anlikSayisi * (ANLIK_PX + ANLIK_ARA_PX)}px)`
            : `${oran}%`
        return (
          <div class="hal" data-hal={durum.anahtar} style={`--gecikme:${i * 140}ms`}>
            <div class="hal-basi">
              <span class="hal-etiket">{durum.etiket}</span>
              <span class="hal-toplam">
                <span class="sayi hal-sayi">{toplam}</span>
                <span class="hal-birim">{s.birim}</span>
              </span>
            </div>

            <div
              class="cubuk"
              role="img"
              aria-label={`${durum.etiket}: sipariş başına ${toplam} dakika, ${durum.adimlar.length} adımın ${elleAdimSayisi} tanesi elle yapılıyor.`}
            >
              <div class="cubuk-ic" style={`--genislik:${genislik}`}>
                {durum.adimlar.map((adim) => (
                  <span
                    class="parca"
                    data-elle={adim.elle ? 'evet' : 'hayir'}
                    data-anlik={adim.dakika === 0 ? 'evet' : 'hayir'}
                    style={
                      adim.dakika === 0
                        ? `flex:0 0 ${ANLIK_PX}px`
                        : `flex:${adim.dakika} 1 0`
                    }
                  />
                ))}
              </div>
            </div>

            <ol class="adimlar">
              {durum.adimlar.map((adim) => (
                <li class="adim" data-elle={adim.elle ? 'evet' : 'hayir'}>
                  <span class="adim-ad">{adim.ad}</span>
                  <span class="adim-sure sayi">
                    {adim.dakika === 0 ? s.anlikEtiketi : `${adim.dakika} ${s.birim}`}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        )
      })
    }
  </div>

  <div class="serit-alt">
    <ul class="gosterge">
      <li><span class="nokta" data-elle="evet"></span>{s.gosterge.elle}</li>
      <li><span class="nokta" data-elle="hayir"></span>{s.gosterge.sistem}</li>
    </ul>
    <p class="serit-not">{s.not}</p>
  </div>
</figure>

<style>
  .serit {
    margin: 0;
    background-color: var(--ml-white);
    border: 1px solid var(--ml-ink-100);
  }

  /* ---------- Başlık ---------- */
  .serit-ust {
    padding: var(--ml-space-6) var(--ml-space-6) var(--ml-space-4);
    border-block-end: 1px solid var(--ml-ink-100);
  }

  .serit-kunye {
    display: block;
    color: var(--ml-cobalt-600);
    margin-block-end: var(--ml-space-2);
  }

  .serit-ad {
    font-family: var(--ml-font-body);
    font-size: var(--ml-text-base);
    font-weight: var(--ml-weight-semibold);
    letter-spacing: 0;
    color: var(--ml-ink-900);
  }

  /* ---------- Gövde ---------- */
  .serit-govde {
    display: grid;
    gap: var(--ml-space-8);
    padding: var(--ml-space-6);
  }

  .hal-basi {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ml-space-4);
    margin-block-end: var(--ml-space-3);
  }

  .hal-etiket {
    font-family: var(--ml-font-mono);
    font-size: var(--ml-text-xs);
    font-weight: var(--ml-weight-medium);
    letter-spacing: var(--ml-tracking-widest);
    text-transform: uppercase;
    color: var(--ml-ink-500);
  }

  .hal[data-hal='sistemle'] .hal-etiket {
    color: var(--ml-cobalt-600);
  }

  .hal-toplam {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .hal-sayi {
    font-size: 1.75rem;
    font-weight: var(--ml-weight-medium);
    line-height: 1;
    color: var(--ml-ink-900);
    letter-spacing: var(--ml-tracking-tight);
  }

  .hal[data-hal='sistemle'] .hal-sayi {
    color: var(--ml-cobalt-600);
  }

  .hal-birim {
    font-family: var(--ml-font-mono);
    font-size: var(--ml-text-xs);
    color: var(--ml-ink-500);
  }

  /* ---------- Çubuk ---------- */
  /* Boş kısım, iki halin aynı ölçekte okunmasını sağlar.
     Dolu parçalarla yarışmaması için açık tutulur. */
  .cubuk {
    height: 26px;
    background-color: var(--ml-cream-base);
    border: 1px solid var(--ml-cream-deep);
  }

  .cubuk-ic {
    display: flex;
    gap: 2px;
    height: 100%;
    width: var(--genislik);
    max-width: 100%;
    transform-origin: left center;
  }

  .parca {
    display: block;
    height: 100%;
    min-width: 3px;
  }

  .parca[data-elle='evet'] {
    background-color: var(--ml-ink-900);
  }

  .parca[data-elle='hayir'] {
    background-color: var(--ml-cobalt-500);
  }

  /* Görünüre girince bir kez çizilir. */
  @media (prefers-reduced-motion: no-preference) {
    .serit[data-gorunur='hayir'] .cubuk-ic {
      transform: scaleX(0);
    }

    .cubuk-ic {
      transition: transform var(--ml-duration-slow) var(--ml-ease-enter);
      transition-delay: var(--gecikme);
    }
  }

  /* ---------- Adım listesi ---------- */
  .adimlar {
    display: grid;
    gap: 0;
    margin-block-start: var(--ml-space-4);
  }

  .adim {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ml-space-4);
    padding-block: 0.4rem;
    border-block-end: 1px solid var(--ml-ink-100);
    font-size: var(--ml-text-sm);
  }

  .adim:last-child {
    border-block-end: 0;
  }

  .adim-ad {
    color: var(--ml-ink-700);
    position: relative;
    padding-inline-start: 1rem;
  }

  .adim-ad::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.52em;
    width: 7px;
    height: 7px;
  }

  .adim[data-elle='evet'] .adim-ad::before {
    background-color: var(--ml-ink-900);
  }

  .adim[data-elle='hayir'] .adim-ad::before {
    background-color: var(--ml-cobalt-500);
  }

  .adim-sure {
    flex: none;
    font-size: var(--ml-text-xs);
    color: var(--ml-ink-500);
  }

  /* ---------- Alt bilgi ---------- */
  .serit-alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--ml-space-3) var(--ml-space-6);
    padding: var(--ml-space-4) var(--ml-space-6);
    border-block-start: 1px solid var(--ml-ink-100);
    background-color: var(--ml-paper);
  }

  .gosterge {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ml-space-4);
    font-family: var(--ml-font-mono);
    font-size: var(--ml-text-xs);
    color: var(--ml-ink-500);
  }

  .gosterge li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nokta {
    width: 8px;
    height: 8px;
  }

  .nokta[data-elle='evet'] {
    background-color: var(--ml-ink-900);
  }

  .nokta[data-elle='hayir'] {
    background-color: var(--ml-cobalt-500);
  }

  .serit-not {
    font-size: var(--ml-text-xs);
    color: var(--ml-ink-500);
    max-width: 46ch;
  }

  @media (min-width: 560px) {
    .serit-govde {
      padding: var(--ml-space-8);
    }

    .serit-ust {
      padding: var(--ml-space-6) var(--ml-space-8) var(--ml-space-5);
    }

    .serit-alt {
      padding-inline: var(--ml-space-8);
    }
  }
</style>

<script is:inline>
  // Çubuklar yalnızca ilk kez görünür olduğunda çizilir.
  ;(function () {
    var serit = document.querySelector('.serit')
    if (!serit) return

    var azHareket = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (azHareket || !('IntersectionObserver' in window)) {
      serit.dataset.gorunur = 'evet'
      return
    }

    serit.dataset.gorunur = 'hayir'
    var gozlemci = new IntersectionObserver(
      function (girisler) {
        girisler.forEach(function (giris) {
          if (giris.isIntersecting) {
            serit.dataset.gorunur = 'evet'
            gozlemci.disconnect()
          }
        })
      },
      { threshold: 0.25 },
    )
    gozlemci.observe(serit)
  })()
</script>

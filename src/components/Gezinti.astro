---
/* Üst gezinti.

   Masaüstü: logo solda, bağlantılar sağda, çağrı en sağda.
   Kaydırılınca çubuk çok hafif bir zemin kazanır. Cam efekti yok,
   bulanıklık ölçülü. Koyu bölümlerin üstünden geçerken çubuk kendi
   tonunu koyuya çevirir.

   Mobil: hamburger tam ekran panel açar. Sonradan eklenmiş bir
   açılır liste değil, kendi düzeni olan bir ekran.
   Panel açıkken odak içeride kalır, Esc kapatır, sayfa kaymaz.
*/

import { sirket } from '../data/site'
import { icerik } from '../data/icerik'
import { yol } from '../lib/yol'

const g = icerik.gezinti
const epostaBelli = !sirket.eposta.startsWith('DEGISTIR')
const tumBaglantilar = [...g.baglantilar, ...g.mobilEk]
---

<header class="ust" data-ust>
  <div class="kabuk ust-ic">
    <a class="logo" href={yol('/')} aria-label={`${sirket.ad} ana sayfa`}>
      <picture class="logo-acik">
        <source srcset={yol('/logo-yatay.avif')} type="image/avif" />
        <source srcset={yol('/logo-yatay.webp')} type="image/webp" />
        <img src={yol('/logo-yatay.png')} alt="Monti Labs" width="177" height="26" />
      </picture>
      <img
        class="logo-koyu"
        src={yol('/logo-yatay-krem.png')}
        alt=""
        aria-hidden="true"
        width="177"
        height="26"
      />
    </a>

    <nav class="masaustu" aria-label="Ana gezinti">
      {g.baglantilar.map((o) => <a href={yol(o.hedef.startsWith('#') ? `/${o.hedef}` : o.hedef)}>{o.etiket}</a>)}
    </nav>

    <a class="ust-cagri baglanti-ok" href={yol('/#iletisim')}>
      {g.cagri}
      <span class="ok" aria-hidden="true">→</span>
    </a>

    <button
      class="acar"
      type="button"
      data-menu-dugmesi
      aria-expanded="false"
      aria-controls="mobil-panel"
    >
      <span class="gorsel-gizli" data-dugme-etiket>{g.menuAc}</span>
      <span class="cizgiler" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<!-- Mobil panel.
     ml-koyu sınıfı düğme ve bağlantıların koyu zemin sürümlerini
     devreye alıyor; kobalt düğme mürekkep zeminde sönük kalıyordu. -->
<div class="panel ml-koyu" id="mobil-panel" data-panel hidden>
  <nav class="panel-ic kabuk" aria-label="Mobil gezinti">
    <ul class="panel-baglantilar">
      {
        tumBaglantilar.map((o, i) => (
          <li style={`--sira:${i}`}>
            <a href={yol(o.hedef.startsWith('#') ? `/${o.hedef}` : o.hedef)} data-panel-baglanti>
              {o.etiket}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="panel-alt">
      {
        epostaBelli && (
          <a class="panel-eposta" href={`mailto:${sirket.eposta}`} data-panel-baglanti>
            {sirket.eposta}
          </a>
        )
      }
      <a class="dugme-birincil panel-cagri" href={yol('/#iletisim')} data-panel-baglanti>
        {g.cagri}
        <span class="ok" aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</div>

<style>
  /* ---------- Çubuk ---------- */
  .ust {
    position: sticky;
    top: 0;
    z-index: 60;
    background-color: transparent;
    border-block-end: 1px solid transparent;
    transition:
      background-color var(--ml-duration-normal) var(--ml-ease-standard),
      border-color var(--ml-duration-normal) var(--ml-ease-standard);
  }

  .ust[data-kaydi='evet'] {
    background-color: rgb(255 251 240 / 0.88);
    backdrop-filter: blur(10px);
    border-block-end-color: var(--ml-ink-100);
  }

  .ust[data-tema='koyu'][data-kaydi='evet'] {
    background-color: rgb(15 21 51 / 0.8);
    border-block-end-color: rgb(255 244 214 / 0.16);
  }

  .ust-ic {
    display: flex;
    align-items: center;
    gap: var(--ml-space-8);
    min-height: 80px;
  }

  /* ---------- Logo ---------- */
  .logo {
    display: grid;
    align-items: center;
    text-decoration: none;
    margin-inline-end: auto;
  }

  .logo > * {
    grid-area: 1 / 1;
    transition: opacity var(--ml-duration-normal) var(--ml-ease-standard);
  }

  .logo img {
    height: 24px;
    width: auto;
  }

  .logo-koyu {
    opacity: 0;
  }

  .ust[data-tema='koyu'] .logo-acik {
    opacity: 0;
  }

  .ust[data-tema='koyu'] .logo-koyu {
    opacity: 1;
  }

  /* ---------- Masaüstü bağlantılar ---------- */
  .masaustu {
    display: none;
    gap: var(--ml-space-8);
  }

  .masaustu a {
    position: relative;
    color: var(--ml-ink-700);
    text-decoration: none;
    font-size: var(--ml-text-sm);
    font-weight: var(--ml-weight-medium);
    padding-block: var(--ml-space-2);
    transition: color var(--ml-duration-fast) var(--ml-ease-standard);
  }

  .masaustu a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ml-duration-normal) var(--ml-ease-standard);
  }

  .masaustu a:hover {
    color: var(--ml-ink-900);
  }

  .masaustu a:hover::after {
    transform: scaleX(1);
  }

  .ust[data-tema='koyu'] .masaustu a {
    color: rgb(255 244 214 / 0.78);
  }

  .ust[data-tema='koyu'] .masaustu a:hover {
    color: var(--ml-cream-base);
  }

  .ust-cagri {
    display: none;
    font-size: var(--ml-text-sm);
    font-weight: var(--ml-weight-semibold);
  }

  .ust[data-tema='koyu'] .ust-cagri {
    color: var(--ml-cream-base);
  }

  /* ---------- Hamburger ----------
     İki çizgi. Açıkken çarpıya döner. */
  .acar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-inline-end: calc(var(--ml-space-3) * -1);
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--ml-ink-900);
  }

  .ust[data-tema='koyu'] .acar {
    color: var(--ml-cream-base);
  }

  .cizgiler {
    display: grid;
    gap: 6px;
    width: 22px;
  }

  .cizgiler i {
    display: block;
    height: 1.5px;
    background-color: currentColor;
    transition:
      transform var(--ml-duration-normal) var(--ml-ease-standard),
      opacity var(--ml-duration-fast) var(--ml-ease-standard);
  }

  .acar[aria-expanded='true'] {
    color: var(--ml-cream-base);
  }

  .acar[aria-expanded='true'] .cizgiler i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .acar[aria-expanded='true'] .cizgiler i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* ---------- Mobil panel ---------- */
  .panel {
    position: fixed;
    inset: 0;
    z-index: 55;
    background-color: var(--ml-ink-900);
    display: flex;
    align-items: flex-end;
    opacity: 0;
    transition: opacity var(--ml-duration-normal) var(--ml-ease-standard);
  }

  .panel[data-acik='evet'] {
    opacity: 1;
  }

  .panel-ic {
    width: 100%;
    padding-block: var(--ml-space-16) var(--ml-space-12);
    padding-block-end: calc(var(--ml-space-12) + env(safe-area-inset-bottom, 0px));
  }

  .panel-baglantilar {
    display: grid;
    gap: var(--ml-space-2);
    border-block-end: 1px solid rgb(255 244 214 / 0.18);
    padding-block-end: var(--ml-space-8);
  }

  .panel-baglantilar a {
    display: block;
    padding-block: var(--ml-space-3);
    font-family: var(--ml-font-display);
    font-size: clamp(2rem, 1rem + 6vw, 2.75rem);
    font-weight: var(--ml-weight-semibold);
    letter-spacing: var(--ml-tracking-tighter);
    line-height: 1.05;
    color: var(--ml-cream-base);
    text-decoration: none;
  }

  .panel-alt {
    display: grid;
    gap: var(--ml-space-6);
    margin-block-start: var(--ml-space-8);
    justify-items: start;
  }

  .panel-eposta {
    color: rgb(255 244 214 / 0.72);
    font-size: var(--ml-text-base);
    text-decoration: none;
  }

  .panel-cagri {
    width: 100%;
  }

  /* Panel açılırken bağlantılar sırayla girer. */
  @media (prefers-reduced-motion: no-preference) {
    .panel-baglantilar li,
    .panel-alt > * {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 0.45s var(--ml-ease-enter),
        transform 0.45s var(--ml-ease-enter);
      transition-delay: calc(var(--sira, 4) * 55ms + 60ms);
    }

    .panel[data-acik='evet'] .panel-baglantilar li,
    .panel[data-acik='evet'] .panel-alt > * {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Kırılma noktaları ---------- */
  @media (min-width: 560px) {
    .logo img {
      height: 26px;
    }
  }

  @media (min-width: 900px) {
    .masaustu,
    .ust-cagri {
      display: flex;
    }

    .acar,
    .panel {
      display: none;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var ust = document.querySelector('[data-ust]')
    if (!ust) return

    /* --- Kaydırma durumu ve koyu bölüm teması --- */
    var koyular = document.querySelectorAll('.ml-koyu, .ml-inverse, [data-koyu]')
    var beklemede = false

    function durumGuncelle() {
      beklemede = false
      ust.dataset.kaydi = window.scrollY > 24 ? 'evet' : 'hayir'
      var hiza = ust.offsetHeight / 2
      var koyu = false
      for (var i = 0; i < koyular.length; i++) {
        // Kapanmakta olan mobil panel hâlâ ekranı kaplıyor ama
        // görünmüyor; saymazsak çubuk yanlışlıkla koyu kalıyor.
        if (getComputedStyle(koyular[i]).opacity === '0') continue
        var r = koyular[i].getBoundingClientRect()
        if (r.top <= hiza && r.bottom >= hiza) {
          koyu = true
          break
        }
      }
      ust.dataset.tema = koyu ? 'koyu' : 'acik'
    }

    function planla() {
      if (beklemede) return
      beklemede = true
      window.requestAnimationFrame(durumGuncelle)
    }

    durumGuncelle()
    window.addEventListener('scroll', planla, { passive: true })
    window.addEventListener('resize', planla, { passive: true })

    /* --- Mobil panel --- */
    var dugme = document.querySelector('[data-menu-dugmesi]')
    var panel = document.querySelector('[data-panel]')
    var etiket = document.querySelector('[data-dugme-etiket]')
    if (!dugme || !panel) return

    var acMetin = etiket ? etiket.textContent : 'Menüyü aç'
    var kapatMetin = 'Menüyü kapat'
    var oncekiOdak = null

    function ac() {
      oncekiOdak = document.activeElement
      panel.hidden = false
      // Bir kare bekle ki geçiş çalışsın
      window.requestAnimationFrame(function () {
        panel.dataset.acik = 'evet'
      })
      dugme.setAttribute('aria-expanded', 'true')
      if (etiket) etiket.textContent = kapatMetin
      // Panel koyu; logonun ve hamburgerin krem sürümüne hemen geçmesi
      // gerekiyor. Kaydırma olayını beklersek mavi logo koyu zeminde
      // bir an okunmaz kalıyor.
      ust.dataset.tema = 'koyu'
      document.body.style.overflow = 'hidden'
      var ilk = panel.querySelector('[data-panel-baglanti]')
      if (ilk) ilk.focus()
    }

    function kapat() {
      panel.dataset.acik = 'hayir'
      dugme.setAttribute('aria-expanded', 'false')
      if (etiket) etiket.textContent = acMetin
      document.body.style.overflow = ''
      durumGuncelle()
      var bitince = function () {
        panel.hidden = true
        panel.removeEventListener('transitionend', bitince)
      }
      panel.addEventListener('transitionend', bitince)
      // Geçiş kapalıysa yine de gizle
      window.setTimeout(function () {
        if (panel.dataset.acik === 'hayir') panel.hidden = true
      }, 400)
      if (oncekiOdak && oncekiOdak.focus) oncekiOdak.focus()
    }

    dugme.addEventListener('click', function () {
      if (dugme.getAttribute('aria-expanded') === 'true') kapat()
      else ac()
    })

    // Bağlantıya tıklanınca kapansın
    panel.addEventListener('click', function (o) {
      if (o.target.closest('[data-panel-baglanti]')) kapat()
    })

    // Esc kapatır, Tab odağı panelin içinde tutar
    document.addEventListener('keydown', function (o) {
      if (panel.hidden) return
      if (o.key === 'Escape') {
        kapat()
        return
      }
      if (o.key !== 'Tab') return
      var odaklanabilir = panel.querySelectorAll('a[href], button:not([disabled])')
      if (!odaklanabilir.length) return
      var ilk = odaklanabilir[0]
      var son = odaklanabilir[odaklanabilir.length - 1]
      if (o.shiftKey && document.activeElement === ilk) {
        o.preventDefault()
        son.focus()
      } else if (!o.shiftKey && document.activeElement === son) {
        o.preventDefault()
        ilk.focus()
      }
    })

    // Masaüstüne geçilirse panel kapansın
    window.matchMedia('(min-width: 900px)').addEventListener('change', function (e) {
      if (e.matches && !panel.hidden) kapat()
    })
  })()
</script>

---
/* Monti.

   Tek paragraf ve iki kurucu kartı. Biyografi yok, unvan enflasyonu
   yok. İkisi de kurucu ortak; CEO ve CTO unvanı iki kişilik bir
   şirkette bir şey anlatmaz.

   Fotoğraf alanı yuvarlak. Fotoğraf gelene kadar baş harfler duruyor;
   içerik dosyasına foto yolu girildiğinde yerini alıyor. */

import { yol } from '../lib/yol'
import type { Icerik } from '../icerik'

interface Props {
  icerik: Icerik
}

const { icerik } = Astro.props
const { monti } = icerik

/** "İsmail Semih Pehlivan" için "İP": ilk ve son kelimenin baş harfi. */
const basHarfler = (ad: string) => {
  const parcalar = ad.trim().split(/\s+/)
  const ilk = parcalar[0]?.[0] ?? ''
  const son = parcalar.length > 1 ? parcalar[parcalar.length - 1]?.[0] ?? '' : ''
  return (ilk + son).toLocaleUpperCase('tr')
}
---

<section class="bolum monti" data-tema="murekkep" id="monti" aria-labelledby="monti-kunye">
  <div class="kabuk kafes">
    <h2 class="etiket ikincil kunye" id="monti-kunye">{monti.kunye}</h2>

    <div class="govde">
      <p class="metin-orta kayar">{monti.metin}</p>

      <ul class="kurucular" aria-label={monti.kurucularKunye}>
        {
          monti.kurucular.map((kisi, sira) => (
            <li class="kurucu cam kayar" style={`transition-delay:${120 + sira * 100}ms`}>
              {kisi.foto ? (
                <img class="foto" src={yol(kisi.foto)} alt="" width="72" height="72" loading="lazy" decoding="async" />
              ) : (
                <span class="foto harf" aria-hidden="true">
                  {basHarfler(kisi.ad)}
                </span>
              )}
              <div>
                <p class="isim">{kisi.ad}</p>
                <p class="unvan ikincil">{kisi.unvan}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .kunye {
    grid-column: span 2;
  }

  .govde {
    grid-column: span 4;
  }

  .kurucular {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--b3);
    margin-top: var(--b6);
  }

  @media (min-width: 40rem) {
    .kurucular {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .kurucu {
    display: flex;
    align-items: center;
    gap: var(--b4);
    padding: 1.5rem 1.75rem;
  }

  .foto {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--cam);
    border: 1px solid var(--cam-cizgi);
  }

  .harf {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variation-settings: 'wdth' 110;
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    color: var(--ikincil);
  }

  .isim {
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .unvan {
    margin-top: var(--b1);
    font-size: 0.9375rem;
  }

  @media (max-width: 62rem) {
    .kunye,
    .govde {
      grid-column: auto;
    }

    .kurucu {
      padding: var(--b4);
      gap: var(--b3);
    }

    .foto {
      width: 3.5rem;
      height: 3.5rem;
    }
  }
</style>

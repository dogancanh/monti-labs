---
/* Nasıl çalışıyoruz.

   Dört adım gerçekten bir sıra olduğu için numaralı. Numaralar
   sıranın kendisi; süs değil.

   Adımlar arasındaki bağlantı, logodan gelen 43 derecelik açıyla
   çizilen ince bir kama. Sayfada bu açının kullanıldığı üç yerden
   biri. */

import { icerik } from '../data/icerik'

const n = icerik.nasilCalisiyoruz
---

<section class="surec bolum" id="nasil-calisiyoruz" aria-labelledby="surec-baslik">
  <div class="kabuk">
    <p class="kunye uste" id="surec-baslik" data-acil>{n.kunye}</p>

    <ol class="adimlar">
      {
        n.adimlar.map((a, i) => (
          <li class="adim" data-acil style={`--gecikme:${i * 80}ms`}>
            <p class="adim-no sayi">{a.no}</p>
            <h3 class="adim-ad">{a.ad}</h3>
            <p class="adim-metin">{a.metin}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .adimlar {
    display: grid;
    gap: 0;
    margin: 0;
    counter-reset: adim;
  }

  .adim {
    position: relative;
    display: grid;
    gap: var(--ml-space-2);
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-block-start: 1px solid var(--ml-border);
  }

  .adim:last-child {
    border-block-end: 1px solid var(--ml-border);
  }

  .adim-no {
    font-size: var(--ml-text-xs);
    font-weight: var(--ml-weight-semibold);
    letter-spacing: var(--ml-tracking-wide);
    color: var(--ml-cobalt-600);
  }

  .adim-ad {
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.625rem);
    line-height: var(--ml-leading-tight);
    letter-spacing: var(--ml-tracking-tight);
  }

  .adim-metin {
    max-width: 34ch;
    font-size: var(--ml-text-sm);
    color: var(--ml-text-muted);
  }

  @media (min-width: 760px) {
    .adimlar {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--ml-space-8);
    }

    .adim {
      border-block-start: 1px solid var(--ml-border);
      padding-block: var(--ml-space-6) var(--ml-space-12);
    }

    .adim:last-child {
      border-block-end: 0;
    }

    /* Adımı bir sonrakine bağlayan kama. Son adımda yok:
       süreç orada bitiyor. */
    .adim:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-block-start: -1px;
      inset-inline-end: calc(var(--ml-space-8) / -2 - 5px);
      width: 10px;
      height: 10.5px;
      background-color: var(--ml-cobalt-200);
      clip-path: polygon(0 0, 100% 0, 100% 100%);
    }
  }
</style>

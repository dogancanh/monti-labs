---
/* Problem, Süreç, Çözüm, Ürün.

   Numaralandırma burada gerçek bir sıra taşıdığı için kullanılıyor.
   Sayfanın başka hiçbir yerinde numaralı işaret yok.
   Adımların üstünden geçen çizgi ve her adımın başındaki işaret,
   akışın yönünü gösterir. */

import { icerik } from '../data/icerik'

const y = icerik.yaklasim
---

<ol class="adimlar">
  {
    y.adimlar.map((adim) => (
      <li class="adim">
        <span class="adim-no sayi">{adim.no}</span>
        <h3 class="adim-ad">{adim.ad}</h3>
        <p class="adim-metin">{adim.metin}</p>
      </li>
    ))
  }
</ol>

<style>
  .adimlar {
    display: grid;
    gap: var(--ml-space-8);
  }

  .adim {
    position: relative;
    padding-block-start: var(--ml-space-6);
    border-block-start: 1px solid var(--ml-cobalt-200);
  }

  /* Akış işareti: çizginin üstünde oturan kobalt blok. */
  .adim::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: 0;
    width: 28px;
    height: 3px;
    background-color: var(--ml-cobalt-600);
  }

  .adim-no {
    display: block;
    font-size: var(--ml-text-xs);
    font-weight: var(--ml-weight-medium);
    letter-spacing: var(--ml-tracking-widest);
    color: var(--ml-cobalt-600);
    margin-block-end: var(--ml-space-2);
  }

  .adim-ad {
    font-size: var(--ml-text-xl);
    margin-block-end: var(--ml-space-3);
  }

  .adim-metin {
    color: var(--ml-text-body);
    font-size: var(--ml-text-sm);
    line-height: var(--ml-leading-relaxed);
  }

  @media (min-width: 700px) {
    .adimlar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--ml-space-12) var(--ml-space-8);
    }
  }

  @media (min-width: 1040px) {
    .adimlar {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--ml-space-6);
    }

    .adim-metin {
      font-size: var(--ml-text-sm);
    }
  }
</style>

---
/* Manifesto.

   Sayfanın tek yüksek sesli anı. Makale değil, duruş.
   Metin kısa tutuldu: bir iddia, üç satır, bir kapanış.

   Kapanıştaki mono damga markanın teknik tarafını taşıyor;
   sayfada başka yerde bu ölçekte mono kullanılmıyor. */

import { icerik } from '../data/icerik'

const m = icerik.manifesto
---

<section class="manifesto ml-koyu" aria-labelledby="manifesto-baslik">
  <div class="kabuk">
    <h2 class="ifade manifesto-baslik" id="manifesto-baslik" data-acil>{m.baslik}</h2>

    <ul class="manifesto-satirlar" role="list">
      {
        m.satirlar.map((s, i) => (
          <li data-acil style={`--gecikme:${140 + i * 90}ms`}>{s}</li>
        ))
      }
    </ul>

    <p class="manifesto-kapanis" data-acil style="--gecikme:440ms">{m.kapanis}</p>

    <p class="manifesto-damga" data-acil style="--gecikme:520ms">{m.vurgu}</p>
  </div>
</section>

<style>
  .manifesto {
    padding-block: clamp(6rem, 3rem + 11vw, 13rem);
  }

  .manifesto-baslik {
    max-width: 18ch;
    color: var(--ml-cream-base);
  }

  .manifesto-satirlar {
    margin-block-start: clamp(3rem, 2rem + 4vw, 5rem);
    display: grid;
    gap: var(--ml-space-3);
    max-width: 40ch;
    font-size: var(--ml-text-lg);
    line-height: var(--ml-leading-snug);
    color: rgb(255 244 214 / 0.72);
  }

  .manifesto-kapanis {
    margin-block-start: var(--ml-space-8);
    max-width: 40ch;
    font-size: var(--ml-text-lg);
    line-height: var(--ml-leading-snug);
    color: var(--ml-cream-base);
    font-weight: var(--ml-weight-medium);
  }

  /* Sağa yaslanmış mono damga. Bölümü bir künye satırıyla kapatıyor. */
  .manifesto-damga {
    margin-block-start: clamp(3.5rem, 2rem + 5vw, 6rem);
    padding-block-start: var(--ml-space-6);
    border-block-start: 1px solid rgb(255 244 214 / 0.22);
    font-family: var(--ml-font-mono);
    font-size: var(--ml-text-sm);
    letter-spacing: var(--ml-tracking-widest);
    text-transform: uppercase;
    color: var(--ml-cream-base);
  }

  @media (min-width: 760px) {
    .manifesto-damga {
      text-align: end;
    }
  }
</style>

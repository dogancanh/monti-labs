---
/* İletişim.

   Tek panel, tek alan. Ziyaretçi e-posta adresini bırakıyor, biz
   yazıyoruz. Uzun form yok; iş konuşmak için yazan birinden dört alan
   doldurmasını istemek gereksiz. Adresini bırakmak istemeyen için
   e-posta doğrudan panelin altında.

   Kişisel veri alındığı için onay kutusu duruyor. Küçük ama var.

   Site statik olduğu için gönderim istemci tarafından yapılıyor.
   Erişim anahtarı boşken form hiç basılmıyor, yerine e-posta kalıyor.
   Işık girişteki ışığın aynısı, üç saniye faz farkıyla. */

import Isik from './Isik.astro'
import { sirket, FORM_SERVISI, DISCORD_BILDIRIM } from '../data/site'
import { yol } from '../lib/yol'
import type { Icerik } from '../icerik'

interface Props {
  icerik: Icerik
}

const { icerik } = Astro.props
const { iletisim } = icerik

const formAcik = FORM_SERVISI.anahtar.trim().length > 0
const altMetin = iletisim.altMetin.replace('{sure}', sirket.formDonusSuresi)
const basari = iletisim.basariMesaji.replace('{sure}', sirket.formDonusSuresi)
const hata = iletisim.hataMesaji.replace('{eposta}', sirket.eposta)
---

<section class="bolum iletisim" data-tema="murekkep" id="iletisim" aria-labelledby="iletisim-baslik">
  <div class="kabuk">
    <div class="panel">
      <Isik en="44rem" gecikme="3s" />

      <div class="ic">
        <h2 class="buyuk-baslik baslik" id="iletisim-baslik">{iletisim.baslik}</h2>
        <p class="metin ikincil alt">{altMetin}</p>

        {
          formAcik ? (
            <form
              class="form"
              data-adres={FORM_SERVISI.adres}
              data-anahtar={FORM_SERVISI.anahtar}
              data-discord={DISCORD_BILDIRIM.adres}
              data-basari={basari}
              data-hata={hata}
              data-gonderiliyor={iletisim.gonderiliyor}
              data-gonder={iletisim.gonderButonu}
              novalidate
            >
              <div class="satir">
                <label class="gorsel-gizli" for="eposta">{iletisim.epostaEtiketi}</label>
                <input
                  id="eposta"
                  name="eposta"
                  type="email"
                  autocomplete="email"
                  placeholder={iletisim.epostaYerTutucu}
                  required
                />
                <button class="dugme dugme-dolu gonder" type="submit">
                  {iletisim.gonderButonu}
                </button>
              </div>

              {/* Web3Forms'un bot tuzağı. Gerçek kullanıcı görmez, bot doldurur. */}
              <input type="checkbox" name="botcheck" class="gorsel-gizli" tabindex="-1" aria-hidden="true" />

              {/* Etiket parçaları arada boşluk oluşmadan birleştiriliyor.
                  Ayrı satırlara yazılırsa bağlantıdan sonra gelen nokta
                  bir boşlukla ayrı düşüyor. */}
              <p class="onay">
                <input id="kvkk" name="kvkk" type="checkbox" required />
                <label for="kvkk"
                  >{iletisim.kvkkOnayOncesi}<a class="bag bag-acik" href={yol('/kvkk')}
                    >{iletisim.kvkkOnayBaglantiEtiketi}</a
                  >{iletisim.kvkkOnaySonrasi}</label
                >
              </p>

              <p class="durum" role="status" aria-live="polite" />
            </form>
          ) : (
            <p class="metin ikincil kapali">{iletisim.formKapali}</p>
          )
        }

        <p class="dogrudan ikincil">
          {iletisim.dogrudanOncesi}
          <a class="bag bag-acik eposta" href={`mailto:${sirket.eposta}`}>{sirket.eposta}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .iletisim {
    padding-top: 0;
    padding-bottom: 0;
  }

  .panel {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem);
    border-radius: var(--kose-panel);
    border: 1px solid rgb(251 246 234 / 0.1);
    text-align: center;
  }

  .ic {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .baslik {
    max-width: 16ch;
    text-wrap: balance;
  }

  .alt {
    margin-top: var(--b4);
    max-width: 40ch;
  }

  .form {
    width: 100%;
    max-width: 30rem;
    margin-top: var(--b5);
  }

  .satir {
    display: flex;
    gap: var(--b3);
  }

  input[type='email'] {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.875rem 1.375rem;
    border-radius: 999px;
    background-color: rgb(251 246 234 / 0.08);
    border: 1px solid rgb(251 246 234 / 0.2);
    font-size: 0.9375rem;
    color: var(--metin);
    transition: border-color var(--hizli) var(--egri);
  }

  input[type='email']::placeholder {
    color: var(--ikincil);
    opacity: 1;
  }

  input[type='email']:focus-visible {
    outline: none;
    border-color: var(--metin);
  }

  .gonder {
    flex: none;
  }

  .gonder[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .onay {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--b2);
    align-items: start;
    margin-top: var(--b4);
    text-align: left;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ikincil);
  }

  .onay input {
    margin-top: 0.25em;
    accent-color: var(--metin);
    width: 0.9375rem;
    height: 0.9375rem;
  }

  .onay .bag {
    color: var(--metin);
  }

  .durum {
    margin-top: var(--b3);
    font-size: 0.9375rem;
    color: var(--metin);
  }

  .durum:empty {
    display: none;
  }

  .kapali {
    margin-top: var(--b5);
  }

  .dogrudan {
    margin-top: var(--b5);
    font-size: 0.9375rem;
  }

  .eposta {
    color: var(--metin);
    overflow-wrap: anywhere;
  }

  @media (max-width: 30rem) {
    .satir {
      flex-direction: column;
    }

    .gonder {
      width: 100%;
    }
  }
</style>

<script>
  /* Form gönderimi.

     Site statik olduğu için istek doğrudan tarayıcıdan gidiyor.
     Web3Forms asıl alıcı; Discord bildirimi varsa ek olarak
     gönderiliyor ve başarısız olursa kullanıcıya yansıtılmıyor,
     çünkü mesaj zaten e-postayla ulaşmış oluyor. */

  const form = document.querySelector<HTMLFormElement>('.form')

  if (form) {
    const dugme = form.querySelector<HTMLButtonElement>('.gonder')!
    const durum = form.querySelector<HTMLParagraphElement>('.durum')!

    const {
      adres = '',
      anahtar = '',
      discord = '',
      basari = '',
      hata = '',
      gonderiliyor = '',
      gonder = '',
    } = form.dataset

    form.addEventListener('submit', async (olay) => {
      olay.preventDefault()

      /* novalidate elle konuldu ki tarayıcı balonu yerine kendi
         akışımız çalışsın, ama kontrolü yine tarayıcıya yaptırıyoruz. */
      if (!form.checkValidity()) {
        form.reportValidity()
        return
      }

      dugme.disabled = true
      dugme.textContent = gonderiliyor
      durum.textContent = ''

      const veri = new FormData(form)
      const eposta = String(veri.get('eposta') ?? '')
      const bot = veri.get('botcheck') != null

      try {
        const yanit = await fetch(adres, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: anahtar,
            subject: `Monti Labs sitesinden görüşme talebi: ${eposta}`,
            from_name: 'Monti Labs sitesi',
            email: eposta,
            message: `Görüşme talebi. Yanıt adresi: ${eposta}`,
            botcheck: bot,
          }),
        })

        if (!yanit.ok) throw new Error(String(yanit.status))

        durum.textContent = basari
        form.reset()

        if (discord && !bot) {
          void fetch(discord, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: `Görüşme talebi: <${eposta}>`.slice(0, 1900) }),
          }).catch(() => {
            /* Bildirim düşmezse kullanıcıyı ilgilendirmiyor. */
          })
        }
      } catch {
        durum.textContent = hata
      } finally {
        dugme.disabled = false
        dugme.textContent = gonder
      }
    })
  }
</script>

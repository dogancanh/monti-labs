---
/* Ad + metin çiftlerinden oluşan liste.
   Prensipler, Farkımız ve Kimler için bölümlerinde kullanılır.
   Ayrım kartla değil, üstten çekilen çizgiyle yapılır. */

interface Kalem {
  readonly ad: string
  readonly metin: string
}

interface Props {
  kalemler: readonly Kalem[]
  /** Geniş ekranda hedeflenen sütun sayısı. */
  sutun?: 2 | 3 | 4
  /** Ad satırının tipografik ağırlığı. */
  vurgu?: 'baslik' | 'cumle'
}

const { kalemler, sutun = 3, vurgu = 'baslik' } = Astro.props
---

<ul class="liste" data-sutun={sutun} data-vurgu={vurgu}>
  {
    kalemler.map((kalem) => (
      <li class="kalem">
        <h3 class="kalem-ad">{kalem.ad}</h3>
        <p class="kalem-metin">{kalem.metin}</p>
      </li>
    ))
  }
</ul>

<style>
  .liste {
    display: grid;
    gap: var(--ml-space-8) var(--ml-space-8);
  }

  .kalem {
    border-block-start: 1px solid var(--ml-border);
    padding-block-start: var(--ml-space-4);
  }

  .kalem-ad {
    font-size: var(--ml-text-lg);
    font-weight: var(--ml-weight-semibold);
    margin-block-end: var(--ml-space-2);
  }

  /* Cümle biçimindeki başlıklar (Farkımız bölümü) daha ölçülü durur. */
  [data-vurgu='cumle'] .kalem-ad {
    font-family: var(--ml-font-body);
    font-size: var(--ml-text-base);
    letter-spacing: 0;
    color: var(--ml-cobalt-600);
  }

  .kalem-metin {
    color: var(--ml-text-body);
    font-size: var(--ml-text-base);
    max-width: 46ch;
  }

  @media (min-width: 720px) {
    [data-sutun='2'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-sutun='3'],
    [data-sutun='4'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1020px) {
    [data-sutun='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    [data-sutun='4'] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

---
/* Tek bir çalışma görselini iki biçimde sunar.
   src uzantısız verilir: /isler/inkstay-bugun
   AVIF destekleyen tarayıcı onu alır, diğerleri WebP'ye düşer.

   PNG yedeği üretilmiyor: WebP desteklemeyen bir tarayıcı bugün
   pratikte yok ve yedek 3,4 MB yer kaplıyordu.

   en / boy zorunlu: yer önceden ayrıldığı için sayfa görsel
   yüklenirken kaymıyor. */

import { yol } from '../lib/yol'

interface Props {
  src: string
  alt: string
  en: number
  boy: number
  sinif?: string
  oncelikli?: boolean
  boyutlar?: string
}

const { src, alt, en, boy, sinif, oncelikli = false, boyutlar } = Astro.props
---

<picture class={sinif}>
  <source srcset={yol(src + '.avif')} type="image/avif" sizes={boyutlar} />
  <img
    src={yol(src + '.webp')}
    alt={alt}
    width={en}
    height={boy}
    sizes={boyutlar}
    loading={oncelikli ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={oncelikli ? 'high' : 'auto'}
  />
</picture>

<style>
  picture,
  img {
    display: block;
  }

  img {
    width: 100%;
    height: auto;
  }
</style>

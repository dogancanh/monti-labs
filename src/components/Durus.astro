---
/* Duruş.

   Solda künye ve "Üç söz." başlığı, sağda üç satır. Her satır iki
   sütun: söz ve tek cümlelik açıklama. Numaralı adım yok, süreç şeması
   yok, ikon yok. Satırlar görüş alanına girerken sırayla beliriyor.

   Üçüncü söz ("kurduğumuz sistemi ekibinize devrederiz") markanın
   ajans olmadığını en net anlatan cümle. Kısaltılmamalı. */

import type { Icerik } from '../icerik'

interface Props {
  icerik: Icerik
}

const { icerik } = Astro.props
const { durus } = icerik
---

<section class="bolum durus" data-tema="murekkep" id="durus" aria-labelledby="durus-baslik">
  <div class="kabuk kafes">
    <div class="sol">
      <p class="etiket ikincil">{durus.kunye}</p>
      <h2 class="bolum-basligi baslik" id="durus-baslik">{durus.baslik}</h2>
    </div>

    <ol class="ilkeler">
      {
        durus.ilkeler.map((ilke, sira) => (
          <li class="ilke kayar" style={`transition-delay:${sira * 100}ms`}>
            <p class="soz">{ilke.baslik}</p>
            <p class="metin ikincil aciklama">{ilke.metin}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .sol {
    grid-column: span 2;
  }

  .baslik {
    margin-top: var(--b3);
  }

  .ilkeler {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .ilke {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--b2) var(--b4);
    padding-block: var(--b4);
    border-top: 1px solid var(--cizgi);
  }

  .ilke:last-child {
    border-bottom: 1px solid var(--cizgi);
  }

  .soz {
    font-variation-settings: 'wdth' 110;
    font-weight: 600;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .aciklama {
    font-size: 1rem;
  }

  @media (min-width: 48rem) {
    .ilke {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-block: 1.75rem;
    }
  }

  @media (max-width: 62rem) {
    .sol,
    .ilkeler {
      grid-column: auto;
    }
  }
</style>

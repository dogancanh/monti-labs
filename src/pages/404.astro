---
/* 404.

   GitHub Pages tek bir 404 sayfası sunuyor ve hangi dilden gelindiğini
   bilmiyor. Bu yüzden sayfa iki dili birlikte gösteriyor: Türkçe üstte,
   İngilizce altında. Ziyaretçiye "yanlış dil" hissi vermeden çıkış
   veriyor.

   Arama motorlarına kapalı, kanonik adres basılmıyor. */

import Temel from '../layouts/Temel.astro'
import { icerikAl } from '../icerik'
import { sayfaYolu } from '../lib/diller'

const tr = icerikAl('tr')
const en = icerikAl('en')
---

<Temel dil="tr" icerik={tr} baslik="Sayfa bulunamadı · Monti Labs" aciklama={tr.bulunamadi.metin} sayfa="/404" tekDil>
  <section class="bolum yok" data-tema="kobalt">
    <div class="kabuk ic">
      <p class="etiket ikincil">404</p>

      <h1 class="goruntu baslik">{tr.bulunamadi.baslik}</h1>
      <p class="metin-buyuk aciklama">{tr.bulunamadi.metin}</p>
      <p class="cikis">
        <a class="bag" href={sayfaYolu('/', 'tr')}>{tr.bulunamadi.buton}</a>
      </p>

      <div class="ikinci" lang="en">
        <p class="metin ikincil">{en.bulunamadi.metin}</p>
        <p class="cikis">
          <a class="bag" href={sayfaYolu('/', 'en')}>{en.bulunamadi.buton}</a>
        </p>
      </div>
    </div>
  </section>
</Temel>

<style>
  .yok {
    display: flex;
    align-items: center;
    min-height: 100svh;
    color: var(--metin);
    padding-block: calc(var(--b8) + var(--b5)) var(--b8);
  }

  .ic {
    width: 100%;
  }

  .baslik {
    margin-top: var(--b4);
    max-width: 14ch;
  }

  .aciklama {
    margin-top: var(--b5);
  }

  .cikis {
    margin-top: var(--b4);
  }

  .ikinci {
    margin-top: var(--b7);
    padding-top: var(--b4);
    border-top: 1px solid var(--cizgi);
  }
</style>

---
import Temel from '../layouts/Temel.astro'
import Manifesto from '../components/Manifesto.astro'
import SurecGorseli from '../components/SurecGorseli.astro'
import Calismalar from '../components/Calismalar.astro'
import Gelistirdiklerimiz from '../components/Gelistirdiklerimiz.astro'
import NasilCalisiyoruz from '../components/NasilCalisiyoruz.astro'
import MontiLabs from '../components/MontiLabs.astro'
import IletisimFormu from '../components/IletisimFormu.astro'
import { icerik } from '../data/icerik'

const c = icerik
---

<Temel>
  {/* 01 — Hero. Tamamen tipografi. Mockup, render, grafik yok. */}
  <section class="giris" aria-labelledby="giris-baslik">
    <div class="kabuk">
      <h1 class="hero-baslik" id="giris-baslik" data-acil>{c.hero.baslik}</h1>

      <p class="giris-alt" data-acil style="--gecikme:120ms">{c.hero.altMetin}</p>

      <div class="giris-eylemler" data-acil style="--gecikme:200ms">
        <a class="cagri" href={c.hero.birincilEylem.hedef}>
          {c.hero.birincilEylem.etiket}
          <span class="ok" aria-hidden="true">→</span>
        </a>
        <a class="cagri-sessiz" href={c.hero.ikincilEylem.hedef}>
          {c.hero.ikincilEylem.etiket}
        </a>
      </div>

      <ul class="giris-alanlar" data-acil style="--gecikme:280ms">
        {c.hero.alanlar.map((a) => <li class="kunye">{a}</li>)}
      </ul>
    </div>
  </section>

  {/* 02 — Manifesto */}
  <Manifesto />

  {/* 03 — Süreç görseli */}
  <SurecGorseli />

  {/* 04 — Çalışmalar */}
  <Calismalar />

  {/* 05 — Neler geliştiriyoruz */}
  <Gelistirdiklerimiz />

  {/* 06 — Nasıl çalışıyoruz */}
  <NasilCalisiyoruz />

  {/* 07 — Monti Labs */}
  <MontiLabs />

  {/* 08 — Kapanış ve form */}
  <section class="kapanis ml-inverse" id="iletisim" aria-labelledby="kapanis-baslik">
    <div class="kabuk">
      <div class="kapanis-bas">
        <h2 class="ifade" id="kapanis-baslik" data-acil>{c.kapanis.baslik}</h2>
        <p class="kapanis-metin" data-acil style="--gecikme:100ms">{c.kapanis.metin}</p>
      </div>

      <div class="kapanis-form" data-acil style="--gecikme:160ms">
        <IletisimFormu />
      </div>
    </div>
  </section>
</Temel>

<style>
  /* ---------- Hero ---------- */
  .giris {
    padding-block: clamp(4rem, 2rem + 7vw, 9rem) clamp(5rem, 3rem + 8vw, 11rem);
  }

  .hero-baslik {
    max-width: 15ch;
  }

  .giris-alt {
    margin-block-start: clamp(2rem, 1rem + 3vw, 3rem);
    font-size: var(--ml-text-xl);
    line-height: var(--ml-leading-snug);
    color: var(--ml-ink-700);
    max-width: 46ch;
  }

  .giris-eylemler {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ml-space-6) var(--ml-space-10, 2.5rem);
    margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }

  /* Alan şeridi. Sayfanın en altındaki çizgiye oturur. */
  .giris-alanlar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ml-space-4) var(--ml-space-8);
    margin-block-start: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    padding-block-start: var(--ml-space-5, 1.25rem);
    border-block-start: 1px solid var(--ml-ink-100);
  }

  .giris-alanlar li {
    color: var(--ml-ink-500);
  }

  /* ---------- Kapanış ---------- */
  .kapanis {
    padding-block: clamp(5rem, 3rem + 9vw, 11rem);
  }

  .kapanis-bas h2 {
    max-width: 16ch;
    color: var(--ml-cream-base);
  }

  .kapanis-metin {
    margin-block-start: var(--ml-space-6);
    font-size: var(--ml-text-xl);
    line-height: var(--ml-leading-snug);
    color: rgb(255 244 214 / 0.82);
    max-width: 34ch;
  }

  .kapanis-form {
    margin-block-start: clamp(3.5rem, 2rem + 5vw, 6rem);
  }

  @media (min-width: 1000px) {
    .kapanis .kabuk {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--ml-space-16);
      align-items: start;
    }

    .kapanis-form {
      margin-block-start: 0;
    }
  }
</style>

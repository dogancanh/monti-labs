---
/* Eski /biz-kimiz adresi.

   Sayfa kaldırıldı; içeriği ana sayfadaki Monti bölümüne indi. Adres
   paylaşılmış veya dizine girmiş olabileceği için 404'e düşürmek yerine
   yönlendiriliyor.

   Statik sunumda sunucu tarafı yönlendirme yok, bu yüzden meta refresh
   ve canonical birlikte kullanılıyor. Betik kapalıysa da bağlantı elle
   tıklanabiliyor. */

import { yol, mutlak } from '../lib/yol'
import { sayfaYolu } from '../lib/diller'
import { icerikAl } from '../icerik'

const hedef = sayfaYolu('/#monti', 'tr')
const hedefKanonik = sayfaYolu('/', 'tr')
const icerik = icerikAl('tr')
---

<!doctype html>
<html lang="tr-TR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Monti Labs</title>
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${hedef}`} />
    <link rel="canonical" href={mutlak(hedefKanonik, Astro.site)} />
    <link rel="icon" href={yol('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <p><a href={hedef}>{icerik.monti.kunye}</a></p>
    <script is:inline define:vars={{ hedef }}>
      window.location.replace(hedef)
    </script>
  </body>
</html>

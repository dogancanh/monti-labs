# NOT: Bu degiskenler yalnizca site bir Node sunucusuna tasindiginda gerekir.
# GitHub Pages statik yayinda kullanilmaz. Ayrinti icin READMEdeki
# "Sunucuya tasimak isterseniz" bolumune bakin.

# ============================================================
# Monti Labs sitesi — ortam değişkenleri
#
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası depoya girmez (.gitignore içinde).
# ============================================================

# Sitenin yayınlandığı adres. Kanonik bağlantılar, site haritası,
# robots.txt ve paylaşım görseli adresleri buradan üretilir.
# Sonda eğik çizgi olmayacak.
SITE_URL=https://montilabs.com


# ------------------------------------------------------------
# İletişim formu gönderimi
#
# Üç seçenek var, sırayla denenir:
#   1. Resend  (RESEND_API_KEY + ILETISIM_ALICI_EPOSTA + GONDEREN_EPOSTA)
#   2. Webhook (WEBHOOK_URL)
#   3. Hiçbiri tanımlı değilse form içeriği sunucu günlüğüne yazılır.
#      Bu yalnızca geliştirme içindir, üretimde kullanılmaz.
# ------------------------------------------------------------

# Resend API anahtarı. https://resend.com adresinden alınır.
RESEND_API_KEY=

# Form mesajlarının düşeceği adres.
# Gönderim başarısız olduğunda kullanıcıya gösterilen adres de budur.
ILETISIM_ALICI_EPOSTA=

# Gönderen adresi. Resend'de bu adresin alan adı doğrulanmış olmalı,
# yoksa gönderim reddedilir.
GONDEREN_EPOSTA=site@montilabs.com

# Resend kullanılmıyorsa form verisi bu adrese JSON olarak POST edilir.
# Slack, Make, n8n veya kendi uç noktanız olabilir.
WEBHOOK_URL=
